# Образец настроек. Скопируй этот файл в .env и заполни значения.
# .env никуда не выкладывай — там твои секретные ключи.
# Формат: ИМЯ=значение, без пробелов вокруг "=" и без кавычек.

# ===================== Telegram =====================

# Токен бота от @BotFather, вида 1234567890:AAH...
TELEGRAM_BOT_TOKEN=
# Твой числовой Telegram ID (узнать у @userinfobot). Бот отвечает только ему.
OWNER_TELEGRAM_ID=
# Часовой пояс для времени суток, сна и сообщений первой
TIMEZONE=Asia/Vladivostok
# Обычно пусто. Нужно, только если с сервера не открывается API Telegram (российские хостинги):
# прокси вида socks5://user:pass@host:1080 или http://host:3128
TELEGRAM_PROXY=
# …или адрес своего релея Bot API за рубежом
TELEGRAM_API_URL=

# ===================== Разговор =====================
# Агрегатор нейросетей с OpenAI-совместимым API.

# Адрес API агрегатора, например https://polza.ai/api/v1
CHAT_BASE_URL=
# API-ключ из личного кабинета агрегатора
CHAT_API_KEY=
# Основная модель для разговора (подобрать помогает tools/compare_models.py), например deepseek/deepseek-v4-pro-0813
CHAT_MODEL=
# Самая дешёвая адекватная модель для служебных задач (факты, сводки и т.п.)
CHEAP_MODEL=
# Запасные модели, если основная отказала. Через запятую, без пробелов
CHAT_FALLBACK_MODELS=
# Отключать «размышления» моделей (быстрее и дешевле). false — если агрегатор ругается на параметр reasoning
CHAT_DISABLE_REASONING=true
# Цены основной модели в рублях за 1 млн токенов — для учёта расходов
PRICE_PER_1M_INPUT_RUB=
PRICE_PER_1M_OUTPUT_RUB=
# Бюджет на разговор в месяц, ₽
MONTHLY_BUDGET_RUB=300

# Резервный агрегатор: включается, если основной не отвечает. Можно оставить пустым
CHAT_BACKUP_BASE_URL=
CHAT_BACKUP_API_KEY=
CHAT_BACKUP_MODEL=

# С какой стадии отношений возможна ERP: friends | close_friends | romance
ERP_MIN_STAGE=romance

# ===================== Картинки — тоже через агрегатор =====================

# Модель, которая понимает картинки — описывает твои фото (~0,003 ₽ за фото)
VISION_MODEL=mistralai/mistral-small-3.2-24b-instruct
# Модели рисования через запятую: первая — основная (Seedream 4, 3 ₽ за картинку),
# последняя — самая дешёвая (z-image, 1,4 ₽): на неё бот переходит при 80% месячного бюджета
IMAGE_MODELS=bytedance/seedream-4,tongyi-mai/z-image

# ===================== Поведение =====================

# Присылает ли Ника свои картинки: true / false
IMAGES_ENABLED=true
MAX_IMAGES_PER_DAY=2
# Сколько раз в день Ника может написать первой
PROACTIVE_PER_DAY=4
# Тестовый режим «пишет первой»: всё в минутах вместо часов. Только для проверки!
PROACTIVE_TEST_MODE=false
